# =====================================================================
# BMAD Code Guardian — environment variables
#
# Copy to .env and fill in (or set as GitHub org secrets in production).
# =====================================================================

# ---- REQUIRED ----

# GitHub Personal Access Token with the "copilot" scope.
# Generate at: https://github.com/settings/tokens (classic)
COPILOT_PAT=

# Auto-provided in GitHub Actions; needed only for local runs.
GITHUB_TOKEN=

# Repository in "owner/name" form. Auto-provided in Actions.
GITHUB_REPOSITORY=bhaveshsingh07/sample-app

# PR metadata. Auto-provided in Actions via workflow env block.
PR_NUMBER=0
PR_HEAD_SHA=
PR_AUTHOR=
PR_TITLE=
PR_URL=

# Path to the diff produced by `git diff <base>..<head>`.
DIFF_PATH=/tmp/push_modifications.diff


# ---- OPTIONAL — Slack notifier ----
# Create at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=


# ---- OPTIONAL — Email notifier (requires nodemailer) ----
EMAIL_SMTP_HOST=smtp.your-org.internal
EMAIL_SMTP_USER=guardian-bot@your-org.com
EMAIL_SMTP_PASS=
EMAIL_RECIPIENTS=platform-security@your-org.com,sre-leads@your-org.com
