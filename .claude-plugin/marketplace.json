{
  "$schema": "https://bmad.dev/schemas/marketplace.v1.json",
  "name": "commit-agent",
  "version": "1.0.0",
  "displayName": "Code Quality Gate (Git Commit)",
  "description": "Server-side AI gatekeeper for PRs. Scans every diff for security flaws, repository drift, and best-practice violations across AEM, modern frontend, and Magento/PHP. Blocks the merge button via GitHub Repository Rulesets.",
  "publisher": "bhaveshsingh07",
  "license": "Internal",
  "homepage": "https://github.com/bhaveshsingh07/commit-agent",
  "categories": [
    "ci-cd",
    "security",
    "code-quality",
    "ai-gatekeeper"
  ],
  "keywords": [
    "github-actions",
    "self-hosted-runner",
    "copilot",
    "pr-gatekeeper",
    "aem",
    "magento",
    "react",
    "bmad"
  ],
  "engines": {
    "node": ">=20.0.0",
    "bmad": ">=0.4.0"
  },
  "contributes": {
    "skills": [
      {
        "id": "code-guardian",
        "path": "skills/code-guardian/SKILL.md",
        "trigger": "pull_request",
        "description": "Routes diff chunks to language-specific compliance prompts and enforces a strict JSON output contract."
      }
    ],
    "workflows": [
      {
        "id": "code-guardian-scan",
        "path": ".github/workflows/code-guardian.yml",
        "callable": true,
        "consumers": "any repository in the organization"
      }
    ],
    "rulesets": [
      {
        "id": "code-guardian-required",
        "path": "config/ruleset.example.json",
        "scope": "organization"
      }
    ]
  },
  "supportedRunners": [
    "self-hosted",
    "linux",
    "macos",
    "x64",
    "arm64"
  ],
  "consumerInstall": {
    "method": "workflow_call",
    "snippet": "uses: bhaveshsingh07/commit-agent/.github/workflows/code-guardian.yml@main"
  },
  "maintainers": [
    {
      "name": "Platform Security Team",
      "email": "platform-security@bhaveshsingh07.internal"
    }
  ]
}
